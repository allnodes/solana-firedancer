uint logfile_fd, uint etc_hosts_fd, uint etc_resolv_conf

write: (or (eq (arg 0) 2)
           (eq (arg 0) logfile_fd))

fsync: (eq (arg 0) logfile_fd)

socket: (and (or (eq (arg 0) "AF_INET")
                 (eq (arg 0) "AF_INET6"))
             (eq (arg 2) 0))

bind: (or (eq (arg 2) "sizeof(struct sockaddr_in)")
          (eq (arg 2) "sizeof(struct sockaddr_in6)"))

ppoll

connect: (not (or (eq (arg 0) 2)
                  (eq (arg 0) etc_resolv_conf)
                  (eq (arg 0) etc_hosts_fd)
                  (eq (arg 0) logfile_fd)))

close: (not (or (eq (arg 0) 2)
                (eq (arg 0) etc_resolv_conf)
                (eq (arg 0) etc_hosts_fd)
                (eq (arg 0) logfile_fd)))

sendto: (and (not (or (eq (arg 0) 2)
                      (eq (arg 0) etc_resolv_conf)
                      (eq (arg 0) etc_hosts_fd)
                      (eq (arg 0) logfile_fd)))
             (eq (arg 3) "MSG_NOSIGNAL"))

recvmsg: (or (eq (arg 2) "MSG_NOSIGNAL|MSG_DONTWAIT")
             (eq (arg 2) 0))

recvfrom: (and (not (or (eq (arg 0) 2)
                        (eq (arg 0) etc_resolv_conf)
                        (eq (arg 0) etc_hosts_fd)
                        (eq (arg 0) logfile_fd)))
               (eq (arg 3) "MSG_NOSIGNAL"))

sendmsg: (or (eq (arg 2) "MSG_NOSIGNAL|MSG_DONTWAIT")
             (eq (arg 2) "MSG_FASTOPEN|MSG_NOSIGNAL")
             (eq (arg 2) "MSG_NOSIGNAL"))

read

lseek: (and (or (eq (arg 0) etc_resolv_conf)
                (eq (arg 0) etc_hosts_fd))
            (eq (arg 1) 0)
            (eq (arg 2) "SEEK_SET"))

setsockopt: (or (and (eq (arg 1) IPPROTO_TCP)
                     (eq (arg 2) TCP_NODELAY))
                (and (eq (arg 1) IPPROTO_TCP)
                     (eq (arg 2) TCP_FASTOPEN_CONNECT))
                (and (eq (arg 1) SOL_SOCKET)
                     (eq (arg 2) SO_SNDBUF))
                (and (eq (arg 1) SOL_SOCKET)
                     (eq (arg 2) SO_RCVBUF))
                (eq (arg 1) SOL_IP)
                (eq (arg 1) IPPROTO_IPV6))

getsockopt: (and (eq (arg 1) SOL_SOCKET)
                 (eq (arg 2) SO_ERROR))

getpid

getrandom

sched_yield

exit: (eq (arg 0) 0)
